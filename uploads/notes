    <script>
        // Start the components script after the DOM is fully loaded
        window.onload = function() {
            // --- ACCORDION LOGIC ---
            const accordionHeaders = document.querySelectorAll('.accordion-header');
            accordionHeaders.forEach(header => {
                header.addEventListener('click', () => {
                    const content = header.nextElementSibling;
                    
                    // Toggle the 'active' class
                    header.classList.toggle('active');
                    
                    if (header.classList.contains('active')) {
                        content.style.maxHeight = content.scrollHeight + "px";
                    } else {
                        content.style.maxHeight = "0"; 
                    }
                });
            });


            // --- SLIDER SWITCH LOGIC ---
            const jsToggle = document.getElementById('jsToggle');
            const statusDisplay = document.getElementById('toggleStatus');

            if (jsToggle) {
                jsToggle.addEventListener('change', (event) => {
                    const isChecked = event.target.checked;
                    if (isChecked) {
                        statusDisplay.textContent = "Status: ON";
                        statusDisplay.classList.remove('text-secondary');
                        statusDisplay.classList.add('text-success', 'fw-bold'); // Bootstrap success color
                    } else {
                        statusDisplay.textContent = "Status: OFF";
                        statusDisplay.classList.remove('text-success', 'fw-bold');
                        statusDisplay.classList.add('text-secondary'); // Bootstrap secondary color
                    }
                });
            }

            // --- SEGMENTED CONTROL LOGIC ---
            const segmentButtons = document.querySelectorAll('.segment-button');
            const segmentStatus = document.getElementById('segmentStatus');
            
            segmentButtons.forEach(button => {
                button.addEventListener('click', () => {
                    // 1. Remove 'active' class from all buttons
                    segmentButtons.forEach(btn => {
                        btn.classList.remove('active');
                    });

                    // 2. Add 'active' class to the clicked button (Standard Bootstrap behavior)
                    button.classList.add('active');

                    // 3. Update the status display
                    const selectedValue = button.getAttribute('data-segment');
                    segmentStatus.textContent = `Selected: ${selectedValue}`;
                    console.log(`Segment selected: ${selectedValue}`);
                });
            });

            // --- STEP NAVIGATION LOGIC ---
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const progressSegments = document.querySelectorAll('.progress-segment');
            const stepStatus = document.getElementById('stepStatus');
            const totalSteps = progressSegments.length;
            let currentStep = 1;

            function updateNavigation() {
                // 1. Update Progress Indicator
                progressSegments.forEach(segment => {
                    const step = parseInt(segment.getAttribute('data-step'));
                    if (step === currentStep) {
                        segment.classList.add('active');
                    } else {
                        segment.classList.remove('active');
                    }
                });

                // 2. Update Button States
                if (currentStep === 1) {
                    prevBtn.classList.add('disabled');
                    prevBtn.disabled = true;
                } else {
                    prevBtn.classList.remove('disabled');
                    prevBtn.disabled = false;
                }

                if (currentStep === totalSteps) {
                    nextBtn.classList.add('disabled');
                    nextBtn.disabled = true;
                } else {
                    nextBtn.classList.remove('disabled');
                    nextBtn.disabled = false;
                }
                
                // 3. Update Status Text
                stepStatus.textContent = `Current Step: ${currentStep} / ${totalSteps}`;
                console.log(`Navigating to step ${currentStep}`);
            }

            // Click Handlers
            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    if (currentStep < totalSteps) {
                        currentStep++;
                        updateNavigation();
                    }
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    if (currentStep > 1) {
                        currentStep--;
                        updateNavigation();
                    }
                });
            }

            // Initialize on load
            updateNavigation();
        };
    </script>
</body>
